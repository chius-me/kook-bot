# Process bootstrap only. The bot token is entered in the WebUI and stored
# encrypted. Do not put a KOOK token in this file.

# Required. At least 32 bytes. Rotating it makes saved ciphertext unreadable.
KOOKBOT_SECRET=replace-with-at-least-32-bytes-secret

# Required. Not stored in the database. Changing it needs a process restart.
KOOKBOT_UI_PASSWORD=replace-me

# Listen address. Inside Compose this must be 0.0.0.0:8765.
KOOKBOT_HTTP_ADDR=127.0.0.1:8765

# SQLite and later audio files. Use a writable directory for local go run.
KOOKBOT_DATA_DIR=./data

KOOKBOT_BASE_URL=https://www.kookapp.cn/api
KOOKBOT_FFMPEG=ffmpeg
KOOKBOT_EDGE_TTS=/opt/edge-tts/bin/edge-tts
KOOKBOT_LOG_LEVEL=info

# Set to 1 only when the panel is served over HTTPS.
# KOOKBOT_COOKIE_SECURE=1

# Set to 1 to allow a TTS URL on a private network.
# KOOKBOT_TTS_ALLOW_PRIVATE=1
