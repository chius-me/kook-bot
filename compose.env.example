# Copy to .env next to docker-compose.yml. Compose reads that file for the
# ${...} substitutions below. Do not commit .env. Do not put a KOOK bot token here.

# Required. At least 32 bytes. Changing it makes saved ciphertext unreadable.
KOOKBOT_SECRET=

# Required. The WebUI password. It is not stored in the database.
KOOKBOT_UI_PASSWORD=

# Image tag. Use the git short SHA. Do not use latest.
# KOOKBOT_IMAGE_TAG=$(git rev-parse --short HEAD)
KOOKBOT_IMAGE_TAG=

# Image name without a tag. Empty means the locally built name kookbot.
# A published image is ghcr.io/chius-me/kook-bot.
# KOOKBOT_IMAGE=ghcr.io/chius-me/kook-bot
KOOKBOT_IMAGE=
